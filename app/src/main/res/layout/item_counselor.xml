<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCounselorCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Counselor Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212529" />

        <TextView
            android:id="@+id/tvCounselorCardSpec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Specialization"
            android:textSize="14sp"
            android:textColor="#495057"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvCounselorCardDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Availability: Monday, Wednesday"
            android:textSize="12sp"
            android:textColor="#6C757D"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/btn_star_big_on"
                android:contentDescription="Rating"
                android:tint="#FFC107" />

            <TextView
                android:id="@+id/tvCounselorCardRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.5 (12 reviews)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:layout_marginStart="4dp"/>
        </LinearLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewReviews"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="View Reviews"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="#0D6EFD"
            android:textColor="#0D6EFD" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
