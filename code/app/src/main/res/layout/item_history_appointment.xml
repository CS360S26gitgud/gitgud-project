<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    android:background="@android:color/white"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvHistoryCounselorName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHistoryDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvHistoryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnLeaveReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leave a Review"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelAppt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRescheduleAppt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reschedule"
            android:layout_marginStart="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvReviewSubmitted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ Review submitted"
        android:textColor="#4CAF50"
        android:textStyle="italic"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>