<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme changed to MaterialComponents for stability on emulators -->
    <style name="Base.Theme.CounsellingApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">#6200EE</item>
        <item name="colorPrimaryVariant">#3700B3</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#03DAC6</item>
        <item name="colorSecondaryVariant">#018786</item>
        <item name="colorOnSecondary">#000000</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Force background to white to avoid system dark mode glitches -->
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <style name="Theme.CounsellingApp" parent="Base.Theme.CounsellingApp" />
</resources>